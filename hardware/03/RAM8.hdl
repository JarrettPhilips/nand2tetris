// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address,  a=dm0, b=dm1, c=dm2, d=dm3, 
                                    e=dm4, f=dm5, g=dm6, h=dm7);
    Register(in=in, load=dm0, out=out0);
    Register(in=in, load=dm1, out=out1);
    Register(in=in, load=dm2, out=out2);
    Register(in=in, load=dm3, out=out3);
    Register(in=in, load=dm4, out=out4);
    Register(in=in, load=dm5, out=out5);
    Register(in=in, load=dm6, out=out6);
    Register(in=in, load=dm7, out=out7);
    Mux8Way16(  a=out0, b=out1, c=out2, d=out3, e=out4, 
                f=out5, g=out6, h=out7, sel=address, out=out);
}